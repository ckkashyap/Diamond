	$(CC) $(KFLAGS) -c $< -o $@

# ── Piano sample generation and embedding ─────────────────────────────────────
# tools/gen_samples is compiled from C and run once to produce the .raw files.
# Each .raw is then embedded as a binary ELF object via objcopy.

tools/gen_samples: tools/gen_samples.c
	gcc -O2 -o $@ $< -lm

$(SAMPLE_RAWS): tools/gen_samples
	@mkdir -p samples
	tools/gen_samples

$(BUILD)/sample_piano_%.o: samples/piano_%.raw | $(BUILD)
	$(OBJCOPY) \
	    -I binary \
	    -O elf64-x86-64 \
	    -B i386:x86-64 \
	    $< $@

# ── embedded TTF font ─────────────────────────────────────────────────────────
$(OBJ_FONT_TTF): $(FONT_TTF) | $(BUILD)
	$(OBJCOPY) \
	    -I binary \
	    -O elf64-x86-64 \
	    -B i386:x86-64 \
	    $< $@

# ── link ──────────────────────────────────────────────────────────────────────
$(KERNEL_ELF): $(OBJS) kernel/linker.ld
	$(LD) $(LDFLAGS) $(OBJS) -o $@

# ── ISO ───────────────────────────────────────────────────────────────────────
iso: $(KERNEL_ELF)
	@mkdir -p $(ISO_ROOT)/boot/limine
	@mkdir -p $(ISO_ROOT)/EFI/BOOT
	cp $(KERNEL_ELF)                    $(ISO_ROOT)/kernel.elf
	cp boot/limine.conf                 $(ISO_ROOT)/boot/limine/limine.conf
	cp $(LIMINE_DIR)/limine-bios.sys    $(ISO_ROOT)/boot/limine/
	cp $(LIMINE_DIR)/limine-bios-cd.bin $(ISO_ROOT)/boot/limine/
	cp $(LIMINE_DIR)/limine-uefi-cd.bin $(ISO_ROOT)/boot/limine/
	cp $(LIMINE_DIR)/BOOTX64.EFI        $(ISO_ROOT)/EFI/BOOT/
	@if [ -f "$(IWL_FW_BIN)" ]; then                           \
	    cp "$(IWL_FW_BIN)" $(ISO_ROOT)/iwlwifi.ucode;          \
	    echo "  bundled $(IWL_FW_BIN)";                        \
	fi
	xorriso -as mkisofs \
	    -b boot/limine/limine-bios-cd.bin \
	    -no-emul-boot \
	    -boot-load-size 4 \
	    -boot-info-table \
	    --efi-boot boot/limine/limine-uefi-cd.bin \
	    -efi-boot-part \
	    --efi-boot-image \
	    --protective-msdos-label \
	    $(ISO_ROOT) \
	    -o $(ISO) 2>/dev/null
	$(LIMINE_DIR)/limine bios-install $(ISO)
	@echo "ISO ready: $(ISO)"

# ── Run in QEMU ───────────────────────────────────────────────────────────────
QEMU   := qemu-system-x86_64
OVMF   := /usr/share/ovmf/OVMF.fd
NIC    ?= e1000

# Pick a host audio backend.  PulseAudio (native or via pipewire-pulse shim)
# works out of the box on virtually every desktop session, so we prefer it
# over QEMU's native pipewire driver — the latter often fails silently when
# the session bus / XDG_RUNTIME_DIR aren't set up exactly right.
# Override with:  make run AUDIODEV=pipewire   (or alsa, sdl, ...)
AUDIODEV ?= $(shell \
    if [ -S "/run/user/$$(id -u)/pulse/native" ]; then echo pa;        \
    elif [ -S "/run/user/$$(id -u)/pipewire-0" ];  then echo pipewire; \
    else echo alsa; fi)

QEMU_COMMON := \
    -machine q35 \
    -bios $(OVMF) \
    -cdrom $(ISO) \
    -m 512M \
    -smp 4 \
    -device bochs-display,xres=2560,yres=1440,vgamem=16777216 \
    -display gtk,zoom-to-fit=on \
    -serial stdio \
    -netdev user,id=net0 \
    -device $(NIC),netdev=net0 \
    -audiodev $(AUDIODEV),id=audio0 \
    -device intel-hda \
    -device hda-duplex,audiodev=audio0 \
    -device virtio-tablet-pci \
    -device virtio-keyboard-pci

KVM_FLAGS := $(shell test -w /dev/kvm && echo "-enable-kvm -cpu host" || echo "-cpu qemu64")

run: iso
	@echo "NIC: $(NIC)  (override with NIC=<device>)"
	@echo "Audio: $(AUDIODEV)  (override with AUDIODEV=<pipewire|pa|alsa|sdl|...>)"
	@echo "Tip: add yourself to the 'kvm' group for much faster execution"
	$(QEMU) $(QEMU_COMMON) $(KVM_FLAGS)

# ── Spice mode (display + audio + input over TCP) ─────────────────────────────
# For running Diamond in QEMU on a remote host over SSH.  The -audiodev pa
# path used by 'make run' pipes guest audio into the *server's* PulseAudio,
# which you can't hear from the SSH client.  Spice streams audio and video
# together over one TCP port so a local client gets both.
#
# On the server:
#    make run-spice                   # port defaults to 5930
#    make run-spice SPICE_PORT=5930
# On your local machine:
#    remote-viewer spice://<server>:5930
#    (install with:  sudo apt install virt-viewer)
SPICE_PORT ?= 5930

QEMU_SPICE := \
    -machine q35 \
    -bios $(OVMF) \
    -cdrom $(ISO) \
    -m 512M \
    -smp 4 \
    -vga qxl \
    -spice port=$(SPICE_PORT),addr=0.0.0.0,disable-ticketing=on \
    -device virtio-serial-pci \
    -chardev spicevmc,id=spicechannel0,name=vdagent \
    -device virtserialport,chardev=spicechannel0,name=com.redhat.spice.0 \
    -serial stdio \
    -netdev user,id=net0 \
    -device $(NIC),netdev=net0 \
    -audiodev spice,id=audio0 \
    -device intel-hda \
    -device hda-duplex,audiodev=audio0

run-spice: iso
	@echo "Spice listening on 0.0.0.0:$(SPICE_PORT)"
	@echo "Connect from your local machine: remote-viewer spice://<this-host>:$(SPICE_PORT)"
	$(QEMU) $(QEMU_SPICE) $(KVM_FLAGS)

# ── Install to EFI partition (dual-boot alongside Linux) ─────────────────────
# Copies kernel.elf + Limine EFI binary + config to /boot/efi/EFI/diamond/.
# Run once: make efi-register   to add the UEFI boot entry via efibootmgr.
# Subsequently: make install    to update the kernel after rebuilding.
EFI_DIR := /boot/efi/EFI/diamond

install: $(KERNEL_ELF)
	@echo "Installing Diamond to $(EFI_DIR) ..."
	sudo mkdir -p $(EFI_DIR)
	sudo mkdir -p /boot/efi/boot/limine
	sudo cp $(KERNEL_ELF)                    $(EFI_DIR)/kernel.elf
	sudo cp $(LIMINE_DIR)/BOOTX64.EFI        $(EFI_DIR)/limine.efi
	sudo cp boot/limine-efi.conf             $(EFI_DIR)/limine.conf
	sudo cp boot/limine-efi.conf             /boot/efi/boot/limine/limine.conf
	@if [ -f "$(IWL_FW_BIN)" ]; then                          \
	    echo "  bundling iwlwifi firmware ..."; \
	    sudo cp "$(IWL_FW_BIN)" $(EFI_DIR)/iwlwifi.ucode;     \
	fi
	@echo "Done. Run 'make efi-register' once to add the UEFI boot entry."

# Run this once to register Diamond in the UEFI boot menu.
# Find the EFI partition disk/part with: lsblk -o NAME,FSTYPE,MOUNTPOINT
efi-register:
	@PART_DEV=$$(findmnt -n -o SOURCE /boot/efi) && \
	 DISK=$$(lsblk -no PKNAME $$PART_DEV) && \
	 PART=$$(cat /sys/class/block/$$(basename $$PART_DEV)/partition) && \
	 echo "Registering Diamond on /dev/$$DISK partition $$PART ..." && \
	 sudo efibootmgr --create \
	     --disk /dev/$$DISK \
	     --part $$PART \
	     --label "Diamond" \
	     --loader '\EFI\diamond\limine.efi' \
	     --unicode && \
	 echo "Boot entry created. Current boot order:" && \
	 sudo efibootmgr

# ── Clean ─────────────────────────────────────────────────────────────────────
clean:
	rm -rf $(BUILD) $(ISO)

$(BUILD):
	mkdir -p $(BUILD)
